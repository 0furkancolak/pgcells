{
  "name": "@0furkancolak/pgcells-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "up": "docker compose -p repo-e2e up -d --build --wait --wait-timeout 300",
    "down": "docker compose -p repo-e2e down -v --remove-orphans",
    "test:e2e": "sh -c 'bun run up && RUN_E2E=1 bun test --timeout 900000 src/e2e.test.ts; status=$?; bun run down; exit $status'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@0furkancolak/pgcells": "workspace:*",
    "@0furkancolak/pgcells-redis": "workspace:*",
    "better-auth": "1.7.5",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.0",
    "eslint": "9.39.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0"
  }
}
